FUNC start:

R0 := 0
R1 := 5
R2 := 6
R3 := 0x1234
R4 := R1
R5 := R2
R6 := R3
R7 := R4

SP := R7
R0 := SP
R1 := PC

R2 := R0 + R1
R3 := R2 + 10
R4 := 10 + R3
R5 := R4 - R2

R6 := R1 & R2
R7 := R1 | R2
R0 := !R7

R1 := R2 << R3
R2 := R1 >> R3
R3 := R2 << 4
R4 := R3 >> 2

R5 := 5 << R2

R1 == R2
R1 != R2
R1 > R2
R1 < R2
R1 >= R2
R1 <= R2

R1 <- [R2]
[R2] -> R1

R3 -> [R4]
[R4] <- R3

BRT greater_path
BRF lesser_path
JMP done

greater_path:
R6 := R6 + 1
JMP done

lesser_path:
R6 := R6 - R1

done:
R7 := R6

END
